{% extends 'base.html.twig' %}
{% block title %}{{ board.name }} - Avatars{% endblock %}
{% block body %}

    {% if pages|length > 1 %}
        <div class="fonts">
            Galleries:
            {% for p in pages %}
                <a href="{{ path('app_avatars', {gallery: p}) }}">{{ p }}</a>
            {% endfor %}
        </div>
    {% endif %}

    {% for category in categories %}
        <table class="table">
            <tr><th class="tbl tdbgh center fonts">{{ category.name }}</th></tr>
            <tr>
                <td class="tbl tdbg1 font avatar-grid">
                    {% for picture in category.pictures %}
                        <form method="post" action="{{ path('app_avatar_choose') }}" class="avatar-option">
                            <input type="hidden" name="_token" value="{{ csrf_token('choose-avatar') }}">
                            <input type="hidden" name="picture" value="{{ picture.id }}">
                            <button type="submit" title="{{ picture.name }}">
                                <img src="{{ picture.url }}" alt="{{ picture.name }}" loading="lazy">
                            </button>
                        </form>
                    {% endfor %}
                </td>
            </tr>
        </table>
    {% else %}
        <table class="table">
            <tr><td class="tbl tdbg1 center font">No avatars have been added yet.</td></tr>
        </table>
    {% endfor %}

{% endblock %}