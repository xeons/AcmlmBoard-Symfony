{% apply spaceless %}
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
    <title>{{ board.name }} - {{ thread.title }}</title>
    <link rel="alternate" type="text/html" href="{{ url('app_thread', {id: thread.id}) }}"/>
    <link rel="self" type="application/atom+xml" href="{{ url('app_feed_thread', {id: thread.id}) }}"/>
    <id>{{ url('app_thread', {id: thread.id}) }}</id>
    <updated>{{ updatedAt|date('c') }}</updated>
    {% for post in posts %}
        <entry>
            <title>{{ post.author ? post.author.username : 'Deleted user' }} - {{ thread.title }}</title>
            <link rel="alternate" type="text/html" href="{{ url('app_post_permalink', {id: post.id}) }}"/>
            <id>{{ url('app_post_permalink', {id: post.id}) }}</id>
            <updated>{{ (post.editedAt ?: post.createdAt)|date('c') }}</updated>
            <published>{{ post.createdAt|date('c') }}</published>
            {% if post.author %}<author><name>{{ post.author.username }}</name></author>{% endif %}
            {#
                The body goes through the sanitizer and is then XML-escaped by Twig.
                The original wrote post HTML straight into the feed, so any post with
                a "<" produced a document no reader could parse.
            #}
            <content type="html">{{ post.body|board_markup }}</content>
        </entry>
    {% endfor %}
</feed>
{% endapply %}