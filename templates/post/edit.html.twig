{% extends 'base.html.twig' %}
{% block title %}{{ board.name }} - Edit post{% endblock %}
{% block body %}
    <div class="breadcrumb font">
        <a href="{{ path('app_thread', {id: thread.id}) }}">{{ thread.title }}</a> &mdash; Edit post
    </div>

    {% if preview %}
        <table class="table post-grid">
            <tr><th class="tbl tdbgh center fonts" colspan="2">Preview</th></tr>
            {% include board.layout ? board.layout.template : 'post/layout/regular.html.twig'
               with {post: preview, striped: 0, thread: thread} only %}
        </table>
    {% endif %}

    {{ form_start(form, {attr: {class: 'board-form'}}) }}
        <table class="table">
            <tr>
                <td class="tbl tdbg1 font" style="width:180px">{{ form_label(form.body) }}</td>
                <td class="tbl tdbg2 font">
                    {% include 'partial/post_toolbar.html.twig' with {target: 'edit_post_body'} only %}
                    {{ form_widget(form.body) }}{{ form_errors(form.body) }}
                </td>
            </tr>
            <tr>
                <td class="tbl tdbg1 font">&nbsp;</td>
                <td class="tbl tdbg2 font">
                    {{ form_widget(form.submit) }} {{ form_widget(form.preview) }}
                </td>
            </tr>
        </table>
    {{ form_end(form) }}
{% endblock %}