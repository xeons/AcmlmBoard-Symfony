{% apply spaceless %}
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
    <title>{{ board.name }} - {{ forum.title }}</title>
    <link rel="alternate" type="text/html" href="{{ url('app_forum', {id: forum.id}) }}"/>
    <link rel="self" type="application/atom+xml" href="{{ url('app_feed_forum', {id: forum.id}) }}"/>
    <id>{{ url('app_forum', {id: forum.id}) }}</id>
    <updated>{{ updatedAt|date('c') }}</updated>
    {% for thread in threads %}
        <entry>
            <title>{{ thread.title }}</title>
            <link rel="alternate" type="text/html" href="{{ url('app_thread', {id: thread.id}) }}"/>
            <id>{{ url('app_thread', {id: thread.id}) }}</id>
            <updated>{{ thread.lastPostAt|date('c') }}</updated>
            <published>{{ thread.createdAt|date('c') }}</published>
            {% if thread.author %}<author><name>{{ thread.author.username }}</name></author>{% endif %}
            <summary type="text">{{ thread.replies }} repl{{ thread.replies == 1 ? 'y' : 'ies' }}</summary>
        </entry>
    {% endfor %}
</feed>
{% endapply %}